###############################################################################
# XStore - Environment Configuration Example
# Copy to .env  ->  cp .env.example .env   and fill every value.
# NEVER commit the real .env file. All secrets below must be rotated for prod.
###############################################################################

# ---------- General ----------
NODE_ENV=production
# Public domain used by Caddy (reverse proxy + automatic HTTPS)
DOMAIN=shop.example.com
ACME_EMAIL=admin@example.com
# Frontend public URL (used by Next.js + CORS allow-list)
APP_URL=https://shop.example.com
# Comma-separated list of origins allowed to call the API (defaults to APP_URL)
CORS_ORIGINS=https://shop.example.com
# Public base URL of the API as seen by the browser
NEXT_PUBLIC_API_URL=https://shop.example.com/api

# ---------- Ports (bind on host) ----------
APP_PORT=4000
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# ---------- PostgreSQL ----------
POSTGRES_USER=xstore
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=xstore
POSTGRES_PORT=5432
DATABASE_URL=postgresql://xstore:change-me-postgres-password@db:5432/xstore?schema=public

# ---------- Redis ----------
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis-password@redis:6379

# ---------- Security secrets (generate with: openssl rand -base64 48) ----------
# Master key used to encrypt (AES-256-GCM) API keys & Marzban passwords at rest.
# MUST be at least 32 characters. Losing it makes encrypted data unrecoverable.
ENCRYPTION_KEY=
# Secret used to sign JWT access tokens (>= 32 chars)
JWT_SECRET=
# Access token lifetime
JWT_EXPIRES_IN=15m
# Refresh token lifetime (seconds) - default 7 days
JWT_REFRESH_EXPIRES_IN=604800
# bcrypt cost factor (12 is a good production default)
BCRYPT_ROUNDS=12

# ---------- Database schema management ----------
# true  -> TypeORM auto-syncs entities (development only)
# false -> use SQL migrations (production, recommended)
DB_SYNC=false
# Seed a super admin on boot when SEED_SUPER_ADMIN=true
SEED_SUPER_ADMIN=true
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-super-admin-password

# ---------- Rate limiting ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# ---------- Trust proxy / Cloudflare ----------
# Set true when running behind Caddy / Cloudflare so request IP is resolved
TRUST_PROXY=true

# ---------- Swagger ----------
# Enable /api/docs (recommended: keep false in production)
SWAGGER_ENABLED=false

# ---------- Bayar.gg (payment gateway) ----------
# Default checkout URL (must be HTTPS and registered in your Bayar.gg dashboard)
BAYARGG_BASE_URL=https://www.bayar.gg/api
BAYARGG_CHECKOUT_URL=https://www.bayar.gg/pay
BAYARGG_PAYMENT_METHOD=qris_bayar_gg
# NOTE: the real BAYARGG_API_KEY and BAYARGG_WEBHOOK_SECRET are NOT stored here.
# They are entered through Admin Panel -> API Keys and stored encrypted in DB.
# The values below are only a first-boot fallback for development.
BAYARGG_API_KEY=
BAYARGG_WEBHOOK_SECRET=

# ---------- Resend (transactional email) ----------
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=noreply@example.com
# NOTE: real RESEND_API_KEY is managed via Admin Panel (encrypted at rest).
RESEND_API_KEY=

# ---------- Marzban ----------
# Default Marzban inbounds used when provisioning users (JSON)
MARZBAN_DEFAULT_INBOUNDS={"vless":["VLESS TCP REALITY"]}
# How often the background worker re-checks server status (minutes)
MARZBAN_STATUS_CHECK_INTERVAL=5
# Timeout for outbound Marzban requests (ms)
MARZBAN_REQUEST_TIMEOUT=15000
